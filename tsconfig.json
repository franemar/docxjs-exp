{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "incremental": true,
    "tsBuildInfoFile": "./.build/tsbuildinfo.json",
    "declaration": false,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "pretty": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "noEmitHelpers": false,
    "importHelpers": false,
    "target": "ES2020",
    "noEmit": true,
    "lib": [
      "ES2017",
      "dom"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": { "@parser/*": ["./src/parser/*"] }
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules"
  ]
}
